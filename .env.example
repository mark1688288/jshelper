# Development reads this file. Production uses .env in the repository root (do not commit it).
# Leave secrets blank. Fill them after creating the Desktop client in the Google Auth platform.
# The refresh token is in the operating system keyring, not in a file. After a scope change, run docs-cli auth.

# development | production. bootstrap uses this value only when APP_ENV is unset.
APP_ENV=development

# --- Cloud project (bootstrap creates it and enables the APIs) ---
GCP_PROJECT_ID=docs-cli-dev
GCP_PROJECT_NAME=Docs CLI
# Optional. GCP_FOLDER_ID is a Cloud Resource Manager folder, not Google Drive. If you set an organization folder, do not also set the organization.
GCP_BILLING_ACCOUNT=
GCP_ORGANIZATION_ID=
GCP_FOLDER_ID=
GOOGLE_DOCS_API=docs.googleapis.com
GOOGLE_DRIVE_API=drive.googleapis.com

# --- OAuth consent screen (External + Testing; fill this only by hand in the Console) ---
GOOGLE_OAUTH_APP_NAME=Docs CLI
GOOGLE_OAUTH_SUPPORT_EMAIL=you@gmail.com
GOOGLE_OAUTH_USER_TYPE=external
GOOGLE_OAUTH_PUBLISHING_STATUS=testing
GOOGLE_OAUTH_TEST_USER=you@gmail.com

# --- Desktop / installed client. Copy the id and secret from the Console. Do not commit real values. ---
GOOGLE_OAUTH_CLIENT_NAME=Docs CLI Desktop
GOOGLE_OAUTH_CLIENT_TYPE=installed
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
# The program binds a random port on 127.0.0.1. This value is written only into credentials.json.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1

# Do not use readonly. drive.file cannot read a folder the user already has.
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/drive
GOOGLE_OAUTH_ACCESS_TYPE=offline
GOOGLE_OAUTH_PROMPT=consent
GOOGLE_OAUTH_PKCE_METHOD=S256
OAUTH_TIMEOUT=3m

# --- Local write path ---
GOOGLE_CREDENTIALS_PATH=credentials.json

# The only index where text can be inserted into an empty document. 0 is the section break, not a paragraph.
DOCS_INSERT_INDEX=1
DOCS_DEFAULT_TITLE=Untitled
# Drive folder id, not GCP_FOLDER_ID. The committed example stays an empty string.
GOOGLE_DRIVE_FOLDER_ID=

# Gemini API model id. Calls to Gemini read .env in the working directory (production).
# If this key is missing or blank, the built-in geminiModel is used. Do not put the API key here.
GEMINI_MODEL=
