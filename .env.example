

Files
# Development 直接讀這個檔。Production 使用根目錄 .env（不要提交）。
# 密鑰留空；在 Google Auth platform 建好 Desktop client 後再填。
# 改 scope 或 client 後要刪掉 token.json，否則舊授權不會更新。

# development | production。bootstrap 只在未指定 APP_ENV 時採用這裡的值。
APP_ENV=development

# --- Cloud 專案（bootstrap 會建立並啟用 API）---
GCP_PROJECT_ID=docs-cli-dev
GCP_PROJECT_NAME=Docs CLI
# 選填。有資料夾就不要同時填組織。
GCP_BILLING_ACCOUNT=
GCP_ORGANIZATION_ID=
GCP_FOLDER_ID=
GOOGLE_DOCS_API=docs.googleapis.com

# --- OAuth 同意畫面（External + Testing，只能手動在 Console 填）---
GOOGLE_OAUTH_APP_NAME=Docs CLI
GOOGLE_OAUTH_SUPPORT_EMAIL=you@gmail.com
GOOGLE_OAUTH_USER_TYPE=external
GOOGLE_OAUTH_PUBLISHING_STATUS=testing
GOOGLE_OAUTH_TEST_USER=you@gmail.com

# --- Desktop / installed client。ID 與 secret 從 Console 複製，勿提交真值。---
GOOGLE_OAUTH_CLIENT_NAME=Docs CLI Desktop
GOOGLE_OAUTH_CLIENT_TYPE=installed
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
# 程式會改綁 127.0.0.1 的隨機埠；此值只寫進 credentials.json。
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1

# 不要用 documents.readonly。drive.file 權限更小，也夠建立並寫入本程式的文件。
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/documents
GOOGLE_OAUTH_ACCESS_TYPE=offline
GOOGLE_OAUTH_PROMPT=consent
GOOGLE_OAUTH_PKCE_METHOD=S256
OAUTH_TIMEOUT=3m

# --- 本機快取與寫入位置 ---
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_TOKEN_FILE_MODE=0600

# 空白文件唯一可插入文字的位置。0 是 section break，不是段落。
DOCS_INSERT_INDEX=1
DOCS_DEFAULT_TITLE=Untitled
# 空字串 = 雲端硬碟根目錄。指定資料夾才需要 Drive API，這次不啟用。
GOOGLE_DRIVE_FOLDER_ID=
